# ============================================================================
# Contoh environment variable — Masjid Al Husaini
# Salin menjadi .env.local untuk pengembangan lokal (JANGAN di-commit).
# Di Vercel, isi lewat Project → Settings → Environment Variables.
# ============================================================================

# --- Akun admin (wajib) -------------------------------------------------------
ADMIN_USERNAME=admin
# Hash bcrypt, BUKAN password asli. Buat dengan: npm run hash-password
# Di .env.local, setiap tanda $ wajib ditulis \$ (lihat README).
ADMIN_PASSWORD_HASH=
# Minimal 32 karakter acak. Buat dengan: npm run generate-secret
SESSION_SECRET=

# --- 2FA Google Authenticator (opsional, sangat disarankan) -------------------
# Buat dengan: npm run totp-setup
ADMIN_TOTP_SECRET=

# --- Upstash Redis (wajib) ----------------------------------------------------
# Otomatis terisi saat Upstash Redis dihubungkan lewat Vercel Marketplace
# (KV_REST_API_URL / KV_REST_API_TOKEN). Nama standar Upstash juga didukung.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Blob (wajib untuk upload foto) ------------------------------------
# Otomatis terisi saat Blob store (akses Public) dihubungkan ke proyek.
BLOB_READ_WRITE_TOKEN=

# --- Opsional ------------------------------------------------------------------
# URL publik situs (untuk metadata/Open Graph). Di Vercel otomatis memakai domain produksi.
# SITE_URL=https://masjidalhusaini.id
# ID kota untuk API myQuran v3 bila pencarian otomatis "Jakarta Pusat" perlu ditimpa.
# MYQURAN_KOTA_ID=
